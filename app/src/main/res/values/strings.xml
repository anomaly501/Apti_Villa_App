    <!-- Privacy -->
    <string name="privacy_screen_title">Privacy &amp; Offline Guarantee</string>
    <string name="privacy_badge_100_offline">100% Offline Core</string>
    <string name="privacy_hero_desc">AptiVilla is built on uncompromising privacy principles. All your questions, tests, study habits, and notes never leave your device.</string>
    <string name="privacy_no_tracking_title">Zero Analytics &amp; Zero Tracking</string>
    <string name="privacy_no_tracking_desc">We do not include Google Analytics, Firebase, Crashlytics, Mixpanel, or any ad networks. Your studying is your private business.</string>
    <string name="privacy_sandbox_title">Isolated Local Storage</string>
    <string name="privacy_sandbox_desc">All aptitude content, performance graphs, and Leitner spaced repetition states are stored strictly within the private Android app sandbox using encrypted-at-rest SQLite.</string>
    <string name="privacy_ownership_title">100% Data Ownership &amp; Portability</string>
    <string name="privacy_ownership_desc">You can export your entire study history, mistakes, and practice data into open standard formats (.aptbackup ZIP and JSON) at any time.</string>
    <string name="privacy_byok_ai_title">Direct-to-Provider AI (BYOK)</string>
    <string name="privacy_byok_ai_desc">Optional AI features use your own private API key. Requests go directly from your device to the AI provider without passing through any intermediate proxy or server.</string>

